# MongoDB connection string
MONGODB_URI=

# Secret used to sign/verify admin session JWTs
JWT_SECRET=

# Seed credentials for the first super admin. Used only on the very first login
# attempt, when no admin-tier account exists yet; after that, admins are managed
# from Settings -> Administrators.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Clerk (public sign-in / sign-up for site visitors — separate from admin auth above)
# https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret — https://dashboard.clerk.com -> your app -> Webhooks
# Endpoint: <your-domain>/api/webhooks, subscribed to user.created / user.updated / user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=

# Brevo (Sendinblue) transactional email is NOT configured here — the sender
# address and SMTP relay credentials are stored in the database and edited from
# the admin dashboard under Settings -> Brevo Email. Nothing in this file is
# read for outgoing mail.
# Credentials to paste there: Brevo -> Settings -> SMTP & API -> SMTP tab (not
# the API keys tab). Brevo's "authorised IPs" security setting applies to its
# HTTP API only, so the REST key fails with a 401 "unrecognised IP address" on
# any host with a changing outbound IP; SMTP isn't restricted that way, so it's
# the only transport used here.

# Cloudinary — used for admin profile photo uploads and instructor photo uploads
# https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Places API — powers live testimonials on the landing page, pulled
# from the kidslab.lk Google Business Profile. Leave blank to fall back to
# the hardcoded testimonials.
# https://console.cloud.google.com -> APIs & Services -> enable "Places API (New)"
GOOGLE_PLACES_API_KEY=
# Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# PayHere payment gateway — https://sandbox.payhere.lk (test) / https://www.payhere.lk (live)
# Merchant Secret is generated per domain under Settings -> Domains & Credentials.
# PAYHERE_MODE is the only value that can charge real cards: it must be exactly
# `live` to do so, and anything else (including blank) stays on sandbox.
PAYHERE_MODE=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Absolute origin used for PayHere's return_url / cancel_url / notify_url.
# PayHere's servers call notify_url directly, so during local development this
# must be a public tunnel (e.g. an ngrok https URL), never http://localhost:3000
# — otherwise the payment notification never arrives and orders stay pending.
NEXT_PUBLIC_APP_URL=

# PayHere Retrieval API — used by the reconciliation sweep at
# /api/payments/reconcile to catch payments whose notify_url callback was lost.
# This is a SEPARATE credential pair from the merchant id/secret above:
# PayHere dashboard -> Settings -> Integrations -> create an app.
# Leave blank to run without reconciliation (fulfilment retries still work).
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Shared secret protecting the reconciliation cron endpoint. Vercel Cron sends
# it automatically as `Authorization: Bearer <CRON_SECRET>`. Generate with:
#   openssl rand -hex 32
CRON_SECRET=
